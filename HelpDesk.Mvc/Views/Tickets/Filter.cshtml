@model List<Ticket>
@{
    ViewData["Title"] = "Filter Tickets by Status";
    var selectedStatus = ViewBag.SelectedStatus as string;
}

<h1 class="h3 mb-4">Filter Tickets by Status</h1>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Filter" method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <label for="status" class="form-label">Status</label>
                <select id="status" name="status" asp-items="ViewBag.Statuses" class="form-select">
                    <option value="">-- Select Status --</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">All Tickets</a>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(selectedStatus))
{
    <h2 class="h5 mb-3">Showing tickets with status: <span class="badge bg-secondary">@selectedStatus</span></h2>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Id</th>
                        <th>Title</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Raised By</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-3">No tickets found for this status.</td></tr>
                    }
                    @foreach (var ticket in Model)
                    {
                        <tr>
                            <td>@ticket.Id</td>
                            <td>@ticket.Title</td>
                            <td>@ticket.Priority</td>
                            <td>@ticket.Status</td>
                            <td>@ticket.RaisedBy</td>
                            <td>@ticket.CreatedDate.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                <a asp-action="Edit" asp-route-id="@ticket.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
